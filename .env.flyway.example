# Copy to .env.flyway. pnpm db:* loads this file automatically (not Next.js .env.local).
# Use the DIRECT connection, or Supabase session pooler (5432), not transaction pooler (6543).
FLYWAY_URL=jdbc:postgresql://db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
FLYWAY_USER=postgres
FLYWAY_PASSWORD='YOUR_DATABASE_PASSWORD'
